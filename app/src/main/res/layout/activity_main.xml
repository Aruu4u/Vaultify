<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    >

    <!-- Header Section with App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:elevation="2dp">

        <!-- App Title -->
        <TextView
            android:id="@+id/appTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vaultify"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#1F1F1F"
            android:letterSpacing="0.02"
            android:layout_marginBottom="4dp"/>

        <!-- Subtitle -->
        <TextView
            android:id="@+id/userEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Secure Your Files"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp"/>
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:fadeScrollbars="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="20dp">

            <!-- Welcome Section Card -->

            <!-- Your Secure Files Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <!-- Section Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Your Secure Files"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1F1F1F"/>

                    <Button
                        android:id="@+id/createFolderBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="+ Add"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="16dp"
                        android:backgroundTint="#2E7D32"
                        android:textAllCaps="false"/>
                </LinearLayout>

                <!-- Folders RecyclerView Container -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FAFAFA">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/folderRecycler"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipToPadding="false"
                            android:padding="12dp"/>

                        <!-- Empty State Placeholder -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:id="@+id/emptyState">

                        </LinearLayout>
                    </FrameLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Quick Stats Section -->


            <!-- Action Buttons Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/requestScreenBtn"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="📋 View Requests"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#1976D2"
                    android:textAllCaps="false"
                    android:layout_marginBottom="10dp"
                    android:elevation="2dp"/>
                <Button
                    android:id="@+id/dashboardBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dashboard" />

                <Button
                    android:id="@+id/logoutBtn"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="🚪 Logout"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#D32F2F"
                    android:textAllCaps="false"
                    android:elevation="2dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>